# Source-File AI Declaration
# AI contribution: 50% or more AI-generated
# Local configuration template.
#
# Copy this file to `.env` in the repository root and adjust values if needed:
#     cp .env.example .env
# `.env` is git-ignored and must never be committed. The defaults below are for local
# development only; real credentials (production database, Toast API keys) never go here.

# --- Local PostgreSQL (used by docker-compose.yml) -----------------------------------
# Docker creates the database with these credentials the first time it starts.
POSTGRES_USER=powr_user
POSTGRES_PASSWORD=powr_password
POSTGRES_DB=powr_dev
# Port on your machine where the database is reachable. Change it (e.g. to 5433) if
# another PostgreSQL already uses 5432, and update the port in DATABASE_URL to match.
POSTGRES_PORT=5432

# --- Backend (read by backend/app/core/config.py) ------------------------------------
# Connection string the backend uses: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Must match the values above. Inside Docker Compose this is overridden automatically
# to point at the `db` container, so it only matters when running the backend directly.
DATABASE_URL=postgresql://powr_user:powr_password@localhost:5432/powr_dev
# One of: development, test, staging, production. staging and production refuse to start
# with the default SESSION_SECRET_KEY or COOKIE_SECURE=false.
ENVIRONMENT=development
# One of: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
# Web origins allowed to call the API from a browser, as a JSON list.
# http://localhost:5173 is the frontend dev server (Vite).
CORS_ORIGINS=["http://localhost:5173"]
# Flagsmith server-side SDK key. Keep this secret; the backend uses it to evaluate flags.
# Create separate keys for local, staging, and production environments.
FLAGSMITH_SERVER_SIDE_KEY=
# Flagsmith client-side environment key. This key is public and is used by the frontend.
VITE_FLAGSMITH_ENVIRONMENT_KEY=
# Optional: replace the Flagsmith API URL when using a self-hosted instance.
FLAGSMITH_API_URL=https://edge.api.flagsmith.com/api/v1/
VITE_FLAGSMITH_API_URL=https://edge.api.flagsmith.com/api/v1/
